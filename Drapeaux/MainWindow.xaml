<Window x:Class="Drapeaux.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Drapeaux"
        mc:Ignorable="d"
        Title="Les villes les plus peuplées"
        Height="450"
        Width="800">

    <Window.Resources>
        <local:LesVilles x:Key="lesvilles" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Label Content="Les villes les plus peuplées"
               Grid.Row="0"
               FontSize="20"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="5" />

        <ListView Grid.Row="1"
                  ItemsSource="{StaticResource lesvilles}"
                  Margin="10">

            <ListView.View>
                <GridView>

                    <GridViewColumn Header="Drapeau" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Pays.Drapeau}"
                                       Width="50"
                                       Height="30"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Ville"
                                    DisplayMemberBinding="{Binding Nom}"
                                    Width="200" />

                    <GridViewColumn Header="Population"
                                    DisplayMemberBinding="{Binding Population}"
                                    Width="200" />

                    <GridViewColumn Header="Pays"
                                    DisplayMemberBinding="{Binding Pays.Nom}"
                                    Width="200" />

                </GridView>
            </ListView.View>

        </ListView>
    </Grid>
</Window>
